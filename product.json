{
  "name": "Telegram Bulk Username Check",
  "brand": "TG Validator",
  "repository": "tgvalidator/telegram-bulk-username-api",
  "description": "Upload a list of Telegram usernames, confirm which ones belong to real accounts, and get the avatar URL.",
  "official_site": "https://tgvalidator.com",
  "landing_page": "https://tgvalidator.com/products/tg_username_batch",
  "canonical_docs": "https://tgvalidator.com/api-docs",
  "base_url": "https://tgvalidator.com",
  "auth": {
    "type": "api_key",
    "header": "X-API-Key"
  },
  "mode": "async-bulk",
  "product": "tg_username_batch",
  "identifier_kind": "username",
  "requires_country": false,
  "endpoints": {
    "submit": {
      "method": "POST",
      "path": "/api/v1/bulk-tasks"
    },
    "status": {
      "method": "GET",
      "path": "/api/v1/bulk-tasks/{id}"
    },
    "balance": {
      "method": "GET",
      "path": "/api/v1/balance"
    }
  },
  "limits": {
    "min_items": 1000,
    "max_items": 100000,
    "poll_interval_seconds": 30,
    "file_formats": [
      "txt",
      "csv"
    ]
  },
  "result_fields": [
    {
      "name": "username",
      "example": "alex_kim",
      "description": "The submitted username (without @)."
    },
    {
      "name": "activated",
      "example": "yes",
      "description": "Whether the username belongs to an existing Telegram account."
    },
    {
      "name": "avatar_url",
      "example": "<image url>",
      "description": "Avatar URL, empty when the account has none."
    }
  ],
  "statuses": [
    "processing",
    "success",
    "failed"
  ],
  "pricing_url": "https://tgvalidator.com/pricing",
  "maintainer": "TG Validator",
  "license": "MIT",
  "last_reviewed": "2026-09-22"
}
