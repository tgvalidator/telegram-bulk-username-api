{
  "name": "Telegram bulk username check",
  "brand": "TG Validator",
  "repository": "tgvalidator/telegram-bulk-username-api",
  "description": "Check Telegram account registration for an authorized list of usernames.",
  "official_site": "https://tgvalidator.com",
  "landing_page": "https://tgvalidator.com/products/tg_username_batch",
  "canonical_docs": "https://tgvalidator.com/api-docs",
  "base_url": "https://tgvalidator.com",
  "auth": {
    "type": "api_key",
    "header": "X-API-Key"
  },
  "mode": "async-bulk",
  "product": "tg_username_batch",
  "identifier_kind": "username",
  "requires_country": false,
  "endpoints": {
    "submit": {
      "method": "POST",
      "path": "/api/v1/bulk-tasks"
    },
    "status": {
      "method": "GET",
      "path": "/api/v1/bulk-tasks/{id}"
    },
    "balance": {
      "method": "GET",
      "path": "/api/v1/balance"
    }
  },
  "limits": {
    "min_items": 1000,
    "max_items": 500000,
    "poll_interval_seconds": 30,
    "file_formats": [
      "txt",
      "csv"
    ]
  },
  "result_fields": [
    {
      "name": "identifier",
      "example": "alex_kim",
      "description": "Submitted identifier, used to join the result to the input. Phone identifiers include their country code."
    },
    {
      "name": "activated",
      "example": "true",
      "description": "The determined positive/negative signal for this product; interpret it in the product context."
    }
  ],
  "statuses": [
    "processing",
    "success",
    "failed"
  ],
  "pricing_url": "https://tgvalidator.com/pricing",
  "maintainer": "TG Validator",
  "license": "MIT",
  "last_reviewed": "2026-10-30"
}
